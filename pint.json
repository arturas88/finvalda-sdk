{
    "preset": "laravel",
    "rules": {
        "concat_space": {
            "spacing": "one"
        },
        "new_with_parentheses": {
            "anonymous_class": false,
            "named_class": true
        },
        "php_unit_method_casing": false,
        "phpdoc_align": false,
        "no_superfluous_phpdoc_tags": false,
        "class_attributes_separation": {
            "elements": {
                "method": "one"
            }
        }
    }
}
