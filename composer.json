{
    "name": "arturas88/finvalda-sdk",
    "description": "PHP SDK for Finvalda (FVS) accounting software web service API",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "finvalda",
        "fvs",
        "accounting",
        "api",
        "sdk",
        "erp",
        "laravel",
        "php"
    ],
    "authors": [
        {
            "name": "Arturas",
            "homepage": "https://github.com/arturas88"
        }
    ],
    "homepage": "https://github.com/arturas88/finvalda-sdk",
    "support": {
        "issues": "https://github.com/arturas88/finvalda-sdk/issues",
        "source": "https://github.com/arturas88/finvalda-sdk"
    },
    "require": {
        "php": "^8.3",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.8",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^9.0|^10.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Finvalda\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Finvalda\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Finvalda\\Laravel\\FinvaldaServiceProvider"
            ],
            "aliases": {
                "Finvalda": "Finvalda\\Laravel\\Facades\\Finvalda"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "format": "pint",
        "check": [
            "pint --test",
            "@analyse",
            "@test"
        ]
    },
    "suggest": {
        "laravel/framework": "Service provider, Facade and publishable config (Laravel 11+)"
    }
}
